{
  "name": "bento-os",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first personal knowledge base and prompt library with a macOS bento-glass UI.",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run build && node server/index.js",
    "start": "node server/index.js",
    "build": "npm run build:css && npm run build:static && npm run build:vendor",
    "build:css": "tailwindcss -i src/css/input.css -o dist/assets/app.css --minify",
    "build:static": "node scripts/copy-static.js",
    "build:vendor": "node scripts/copy-vendor.js",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dompurify": "^3.2.6",
    "express": "^4.21.2",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.6.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
