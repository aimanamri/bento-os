{
  "name": "bento-os",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first personal knowledge base and prompt library with a macOS bento-glass UI.",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run build && node server/index.js",
    "start": "node server/index.js",
    "build": "npm run build:css && npm run build:static && npm run build:vendor && npm run build:js && npm run build:sw",
    "build:css": "tailwindcss -i src/css/input.css -o dist/assets/app.css --minify",
    "build:static": "node scripts/copy-static.js",
    "build:vendor": "node scripts/copy-vendor.js",
    "build:js": "node scripts/build-js.js",
    "build:sw": "node scripts/build-sw.js",
    "build:readable": "BENTO_OBFUSCATE=0 npm run build",
    "icons": "node scripts/make-icons.js",
    "audit:deps": "npm audit"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "dompurify": "^3.2.6",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.5.0",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.6.0",
    "prismjs": "^1.30.0",
    "tailwindcss": "^3.4.17"
  }
}
