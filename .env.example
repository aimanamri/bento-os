# Bento OS — copy to `.env` (same directory as docker-compose.yml).
#
#   cp .env.example .env
#
# These are the DEFAULTS the stack already uses, spelled out so you can see
# and change them. The stack runs without a .env file at all; you need one to
# change a port, or — before exposing this to anything but loopback — to
# replace the credentials below.
#
# .env is gitignored. .env.example is the only variant that is committed.

# ─────────────────────────────────────────────────────────────────────
# PostgreSQL  (service: db — image supabase/postgres)
# ─────────────────────────────────────────────────────────────────────
# Default superuser is `postgres`. This password is also given to the
# internal roles the stack signs in as (supabase_auth_admin for GoTrue,
# authenticator for PostgREST), so changing it here changes it everywhere.
#
#   Connect from the host:
#     psql postgresql://postgres:bentoos-local-dev-password@127.0.0.1:54322/postgres
POSTGRES_PASSWORD=bentoos-local-dev-password
POSTGRES_DB=postgres

# Host port for direct psql / TablePlus / DBeaver access.
# 5432 inside the container; 54322 on the host to match the Supabase CLI
# convention and to avoid colliding with a Postgres you already run locally.
POSTGRES_HOST_PORT=54322

# ─────────────────────────────────────────────────────────────────────
# JWT / API keys  (shared by GoTrue, PostgREST and the Edge Functions)
# ─────────────────────────────────────────────────────────────────────
# ANON_KEY and SERVICE_ROLE_KEY are HS256 JWTs signed with JWT_SECRET. All
# three MUST stay in sync — regenerate the pair after changing the secret:
#
#   node scripts/gen-local-keys.js "<your-new-secret-at-least-32-chars>"
#
# then paste the output here AND put the new ANON_KEY into
# src/js/supabase-config.js, and rebuild: docker compose up -d --build
JWT_SECRET=bento-os-local-dev-jwt-secret-change-me-32b
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjIwODI3NTg0MDB9.esm2v7G-HRRUBJh_zPGSSMoBmJwQEWELsN9A0J5x4gM
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3NjcyMjU2MDAsImV4cCI6MjA4Mjc1ODQwMH0.IwKkrsdxz1hoNFVWpZp5iQlrWlWPwgO6pVUwbDiG1Tw

# How long an access token stays valid, in seconds (refresh is automatic).
JWT_EXPIRY=3600

# ─────────────────────────────────────────────────────────────────────
# Ports / origins
# ─────────────────────────────────────────────────────────────────────
# The app itself.
BENTO_BIND=127.0.0.1
BENTO_HOST_PORT=8481

# The Supabase API gateway. The browser calls this directly, and the URL is
# baked into the bundle at build time — changing it needs `up -d --build`.
GATEWAY_HOST_PORT=8000

# Dev profile. 3001 by default so a host `npm run dev` (which targets Supabase
# Cloud) can keep using 3000 at the same time.
BENTO_DEV_HOST_PORT=3001

# ─────────────────────────────────────────────────────────────────────
# Dev profile only
# ─────────────────────────────────────────────────────────────────────
# On a Linux host set these to your own `id -u` / `id -g`, or the dev
# container cannot write dist/ into the bind mount (EACCES).
# DOCKER_UID=1000
# DOCKER_GID=1000
