# Dependencies / build output (reinstalled + regenerated inside the image)
node_modules/
**/node_modules/
dist/
npm-debug.log
.npm

# Sibling checkouts of the other variant branches — hundreds of MB of build
# context that would otherwise be uploaded to the daemon on every build.
.worktrees/

# VCS / editor / OS cruft
.git
.gitignore
.gitattributes
.claude
.vscode/
.editorconfig
.prettierrc
.eslintrc*
.DS_Store

# Secrets & local data — never copy into the build context
*.env
*.env.local
backups/
data/

# Docs, notes, and generated analysis — not needed at build or runtime
docs/
*.md
graphify-out/
.graphify*
scratchpad/

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore
