# Dependencies / build output (reinstalled + regenerated inside the image)
node_modules/
**/node_modules/
dist/
npm-debug.log
.npm

# Sibling checkouts of the other variant branches — hundreds of MB of build
# context that would otherwise be uploaded to the daemon on every build.
.worktrees/

# VCS / editor / OS cruft
.git
.gitignore
.gitattributes
.claude
.vscode/
.editorconfig
.prettierrc
.eslintrc*
.DS_Store

# Secrets & local data — never copy into the build context
*.env
*.env.local
backups/
data/
*.db
*.db-shm
*.db-wal

# Supabase CLI project (migrations + Edge Functions) — deployed with the
# `supabase` CLI, never needed to build or run the container.
supabase/

# Docs, notes, and generated analysis — not needed at build or runtime
docs/
*.md
graphify-out/
.graphify*
scratchpad/

# Docker files themselves. docker/ holds the self-hosted stack's gateway conf,
# Edge Functions router and migration runner — all bind-mounted into their own
# containers at run time, never built into the app image.
Dockerfile*
docker-compose*.yml
.dockerignore
docker/
.env.example
