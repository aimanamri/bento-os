# syntax=docker/dockerfile:1
#
# Bento OS — development image.
# Meant to run with the source bind-mounted (see the `dev` profile in
# docker-compose.yml). `npm run dev` rebuilds assets then starts the server;
# there is no file watcher, so restart the container to pick up changes.
#
# Service-worker gotcha while iterating: a rebuilt dist means a new worker,
# but the running one keeps serving its cached assets until every tab is
# closed (it waits by design — src/sw.js). If a change doesn't show up after
# a restart + reload, tick DevTools → Application → Service Workers →
# "Update on reload", or use a private window.
FROM node:22-alpine
ENV NODE_ENV=development
WORKDIR /app

RUN apk add --no-cache tini \
 && addgroup -g 1001 -S nodejs \
 && adduser -S nodejs -u 1001

COPY package*.json ./
# devDependencies are required — tailwind + the client vendor libs are what
# `npm run build` compiles and copies into dist/.
# --omit=optional drops better-sqlite3, exactly as the production image does:
# it only backs the local-SQLite variant (dev-local-auth) and the one-off
# migrate:data script. Nothing in `npm run dev` loads it, and skipping it
# avoids a pointless from-source native build against musl.
RUN npm ci --omit=optional

COPY . .
# The anonymous node_modules volume must be writable by the unprivileged
# runtime user. There is no data dir — state lives in Supabase.
RUN chown -R nodejs:nodejs /app/node_modules

USER nodejs
EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["npm", "run", "dev"]
