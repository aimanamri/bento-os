{
  "id": "/",
  "name": "Bento OS",
  "short_name": "Bento OS",
  "description": "個人用のナレッジベースとプロンプト集。ドキュメント記録帳、プロンプトライブラリ、コードスニペットを、ひとつの弁当ガラスの作業台に。",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#0f1216",
  "theme_color": "#0f1216",
  "categories": [
    "productivity",
    "utilities"
  ],
  "lang": "ja",
  "dir": "ltr",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "ドキュメント記録帳",
      "url": "/?tool=logbook"
    },
    {
      "name": "プロンプトライブラリ",
      "url": "/?tool=prompts"
    },
    {
      "name": "コードスニペット",
      "url": "/?tool=snippets"
    }
  ]
}
