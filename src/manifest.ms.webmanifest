{
  "id": "/",
  "name": "Bento OS",
  "short_name": "Bento OS",
  "description": "Pangkalan pengetahuan dan pustaka prompt peribadi — Buku Log Dokumen, Pustaka Prompt dan Coretan Kod dalam satu ruang kerja kaca bento.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#0f1216",
  "theme_color": "#0f1216",
  "categories": ["productivity", "utilities"],
  "lang": "ms",
  "dir": "ltr",
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Buku Log Dokumen", "url": "/?tool=logbook" },
    { "name": "Pustaka Prompt", "url": "/?tool=prompts" },
    { "name": "Coretan Kod", "url": "/?tool=snippets" }
  ]
}
